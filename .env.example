# Host binding and port
LOGMASK_BIND=0.0.0.0
LOGMASK_PORT=8090

# Initial administrator. Leave the password empty to generate it in
# data/bootstrap-admin.txt on the first start.
LOGMASK_ADMIN_USER=admin
LOGMASK_ADMIN_PASSWORD=

# Set true only when the application is served over HTTPS.
LOGMASK_COOKIE_SECURE=false

# Session and login protection
LOGMASK_SESSION_IDLE_SECONDS=1800
LOGMASK_SESSION_MAX_SECONDS=28800
LOGMASK_LOGIN_MAX_FAILURES=5
LOGMASK_LOGIN_WINDOW_SECONDS=900
# Limiti upload. I PST e gli export XQL/Discover superano facilmente i default
# minimi: 96/64 MiB coprono l'uso tipico. Per PST piu' grandi alza entrambi
# (il body deve restare sopra il file) e considera la RAM del container.
LOGMASK_MAX_BODY_BYTES=100663296
LOGMASK_MAX_FILE_BYTES=67108864

# Customer-name denylist (v0.10.7): names listed here never leak from free
# text. Comma-separated, or one name per line in data/client_terms.txt
# (LOGMASK_CLIENT_TERMS_FILE overrides the path).
# Example: LOGMASK_CLIENT_TERMS=Acme,Contoso Srl
LOGMASK_CLIENT_TERMS=
LOGMASK_CLIENT_TERMS_FILE=

# How a matched client name is rendered (v0.10.21):
#   pseudonymize -> generic deterministic token CLIENT-xxxxxx (DEFAULT):
#                   readable, clients stay distinct, irreversible (per-tenant).
#   elide        -> [ELIDED] (previous behaviour).
#   label        -> one fixed label (LOGMASK_CLIENT_TERM_LABEL, default [CLIENTE]).
LOGMASK_CLIENT_TERM_MODE=pseudonymize
LOGMASK_CLIENT_TERM_LABEL=[CLIENTE]

# Public CIDR ranges OWNED by the tenant (egress/NAT): masked even with
# ip_mode=internal, because they identify the organization (v0.10.9).
# Comma-separated, or one per line in data/tenant_networks.txt.
# Example: LOGMASK_TENANT_NETWORKS=93.57.78.0/24,151.12.0.0/16
LOGMASK_TENANT_NETWORKS=
LOGMASK_TENANT_NETWORKS_FILE=

# Hostname naming conventions: bare machine names in pasted tables are masked
# reversibly. Literal names, or '*' as a wildcard anywhere (v0.10.24):
# prefix (srv-*), suffix (*QNS), middle (KDA*QNS), domain (*.WORKGROUP,
# *ZCORP.DOM). A lone '*' is ignored. Applies to text AND kept columns.
# Example: LOGMASK_HOST_TERMS=srv-*,WKS*,*QNS,*.WORKGROUP,server-sso
LOGMASK_HOST_TERMS=
LOGMASK_HOST_TERMS_FILE=

# Vendor kits directory (v0.12.0). Bundled kits live in ./kits (YAML). Drop your
# own *.yaml here to ADD a kit, or EXTEND/REPLACE a bundled one (mode: extend|
# replace). Files are hot-reloaded on change. Default: <LOGMASK_DATA>/kits.
# Invalid actions/kinds are dropped and unsafe (ReDoS) patterns rejected.
LOGMASK_KITS_DIR=

# Nomi di persona (v0.19.0). Dalle liste generiche (./persons + LOGMASK_PERSONS_DIR,
# default <LOGMASK_DATA>/persons) viene mascherata SOLO la coppia "Nome Cognome":
# un token singolo no, perche' Costa/Monti/Will/May/June sono anche parole comuni
# dei log. Il token singolo si maschera solo se elencato qui o in
# data/person_terms.txt: sono le persone realmente esistenti in quel cliente.
LOGMASK_PERSON_TERMS=
LOGMASK_PERSON_TERMS_FILE=
LOGMASK_PERSONS_DIR=
